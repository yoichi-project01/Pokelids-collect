generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PhotoMedal {
  GOLD
  SILVER
  NONE
}

model Prefecture {
  id           Int    @id
  nameJa       String @map("name_ja")
  nameEn       String @map("name_en")
  region       String
  displayOrder Int    @map("display_order")

  pokeLids PokeLid[]

  @@map("prefectures")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  isAdmin      Boolean  @default(false) @map("is_admin")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens       RefreshToken[]
  collections         Collection[]
  photos              Photo[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @map("token_hash")
  deviceInfo String?   @map("device_info")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model PokeLid {
  id                String    @id @default(uuid())
  officialRef       String?   @unique @map("official_ref")
  name              String
  pokemonFeatured   String[]  @map("pokemon_featured")
  prefectureId      Int       @map("prefecture_id")
  municipality      String
  address           String
  latitude          Decimal   @db.Decimal(9, 6)
  longitude         Decimal   @db.Decimal(9, 6)
  installDate       DateTime? @map("install_date") @db.Date
  officialImageUrl  String?   @map("official_image_url")
  officialSourceUrl String    @map("official_source_url")
  notes             String?
  lastSyncedAt      DateTime? @map("last_synced_at")
  // Set by the ETL when a previously-seen officialRef is missing from a scrape
  // (physically removed/closed), cleared again if it later reappears (a
  // renewal-triggered false positive recovering). Never deleted outright:
  // Collection has onDelete: Cascade on pokeLidId, so removing the row would
  // also delete every user's record and photos of having collected it.
  retiredAt         DateTime? @map("retired_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  prefecture  Prefecture   @relation(fields: [prefectureId], references: [id])
  collections Collection[]

  @@index([prefectureId])
  @@index([retiredAt])
  @@map("poke_lids")
}

model Collection {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  pokeLidId String   @map("poke_lid_id")
  visitedAt DateTime @map("visited_at")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pokeLid PokeLid @relation(fields: [pokeLidId], references: [id], onDelete: Cascade)
  photos  Photo[]

  @@unique([userId, pokeLidId])
  @@index([userId])
  @@index([pokeLidId])
  @@map("collections")
}

model Photo {
  id                 String     @id @default(uuid())
  collectionId       String     @map("collection_id")
  userId             String     @map("user_id")
  filePath           String     @map("file_path")
  originalFilename   String     @map("original_filename")
  mimeType           String     @map("mime_type")
  fileSizeBytes      Int        @map("file_size_bytes")
  width              Int?
  height             Int?
  exifCapturedAt     DateTime?  @map("exif_captured_at")
  // Distance in meters from the photo's EXIF GPS coordinates to the poke
  // lid's registered location, computed once at upload time. The medal
  // determination (determinePhotoMedal, @pokelids/shared) only ever needs
  // this distance, never the raw coordinates — so unlike the file itself
  // (EXIF-stripped by sharp on re-encode, see resizeForStorage), there's no
  // reason to persist where the photo was actually taken.
  exifDistanceMeters Float?     @map("exif_distance_meters")
  medal              PhotoMedal @default(NONE)
  // 1収集記録につき true は最大1枚という制約は、マイグレーションで生SQLの
  // 部分ユニークインデックス（one_primary_per_collection、WHERE is_primary）
  // として定義している。Prisma は部分ユニークインデックス未対応のため、
  // ここに @@unique 等を書かないこと。書くと通常の（WHERE句なしの）
  // ユニーク制約と解釈され、prisma migrate dev がドリフトとして検出する。
  isPrimary          Boolean    @default(false) @map("is_primary")
  createdAt          DateTime   @default(now()) @map("created_at")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  // 1-2 のアップロード容量チェック（userId で fileSizeBytes を集計）用。
  // TASKS.md 2-4 で予定されていたインデックスだが、このタスクで先に追加する。
  @@index([userId])
  @@map("photos")
}
