# Postgres
POSTGRES_USER=pokelids
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pokelids
DATABASE_URL=postgresql://pokelids:change-me@pokelids_postgres:5432/pokelids

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL_DAYS=30
PHOTO_TOKEN_SECRET=change-me-photo-token-secret

# App
NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://your-domain.example
PHOTO_STORAGE_PATH=/data/photos

# Host paths bind-mounted into the containers by docker-compose.yml (defaults
# shown here; only needed if you want to store data somewhere else)
# POSTGRES_DATA_HOST_DIR=/home/setoyama/pokelids/postgres
# PHOTO_STORAGE_HOST_DIR=/mnt/photos/pokelids

# Admin bootstrap (leave blank after first seed to avoid resetting password)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me

# ETL (etl/scrape.ts) User-Agent contact address
ETL_CONTACT_EMAIL=admin@example.com

# Password reset emails (Resend — https://resend.com). Leave RESEND_API_KEY
# blank to fall back to logging the reset link to the server console
# instead of sending it (useful for local dev without a Resend account).
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@your-domain.example
