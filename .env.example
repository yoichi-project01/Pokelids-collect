# Postgres
POSTGRES_USER=pokelids
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pokelids
DATABASE_URL=postgresql://pokelids:change-me@pokelids_postgres:5432/pokelids

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL_DAYS=30

# App
NODE_ENV=production
PORT=3000
CORS_ORIGIN=*
PHOTO_STORAGE_PATH=/data/photos

# Admin bootstrap (leave blank after first seed to avoid resetting password)
ADMIN_SEED_EMAIL=setoyama.yoichi@gmail.com
ADMIN_SEED_PASSWORD=change-me
