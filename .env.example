# Postgres
POSTGRES_USER=pokelids
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pokelids
DATABASE_URL=postgresql://pokelids:change-me@pokelids_postgres:5432/pokelids

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL_DAYS=30
PHOTO_TOKEN_SECRET=change-me-photo-token-secret

# App
NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://your-domain.example
PHOTO_STORAGE_PATH=/data/photos

# Host paths bind-mounted into the containers by docker-compose.yml (defaults
# shown here; only needed if you want to store data somewhere else)
# POSTGRES_DATA_HOST_DIR=/home/setoyama/pokelids/postgres
# PHOTO_STORAGE_HOST_DIR=/mnt/photos/pokelids

# scripts/backup.sh's output directory (5-3) — default shown here. Keep this
# off whatever disk POSTGRES_DATA_HOST_DIR lives on; a full photo backup
# competing with the database for space defeats the point of backing up.
# BACKUP_ROOT=/mnt/photos/pokelids-backups

# Admin bootstrap (leave blank after first seed to avoid resetting password)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me

# ETL (etl/scrape.ts) User-Agent contact address
ETL_CONTACT_EMAIL=admin@example.com

# Upload limits (POST /api/collections) — all optional, defaults shown here
# UPLOAD_RATE_LIMIT_PER_HOUR=60
# MAX_PHOTOS_PER_COLLECTION=5
# MAX_USER_STORAGE_MB=500

# Data export (7-3, POST /api/export) — optional, default shown here
# EXPORT_RATE_LIMIT_PER_DAY=5

# Password reset emails (Resend — https://resend.com). Leave RESEND_API_KEY
# blank to fall back to logging the reset link to the server console
# instead of sending it (useful for local dev without a Resend account).
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@your-domain.example

# AdSense (MONETIZATION.md). Publisher ID from the AdSense dashboard
# ("ca-pub-..."), baked into the web build at BUILD time (same mechanism as
# GOOGLE_CLIENT_ID below — see docker-compose.yml's build args and the
# Dockerfile's mobile-build stage). Leaving this blank omits the <script>
# tag entirely rather than emitting one with an empty client id. This is
# the coarse, rebuild-required foundation MONETIZATION.md §10.7's actual
# (runtime, no-rebuild) kill switch will sit on top of once real ad slots
# exist — clearing this and rebuilding stops the AdSense script from
# loading at all, which is enough for now since no ads are served yet.
ADSENSE_CLIENT_ID=

# Google sign-in (5-4). Create an OAuth 2.0 Client ID (type: Web application)
# in Google Cloud Console, with an Authorized redirect URI of exactly
# https://your-domain.example/auth/google/callback (must match apps/api's
# GOOGLE_REDIRECT_URI in src/lib/googleAuth.ts exactly, including scheme and
# no trailing slash). GOOGLE_CLIENT_ID also needs to reach the web build at
# BUILD time (baked in as EXPO_PUBLIC_GOOGLE_CLIENT_ID via a docker build arg
# — see docker-compose.yml), not just the running container, so re-run
# `docker compose build` (not just `up -d`) after changing it.
# Leaving these blank disables Google sign-in: the server rejects
# /api/auth/google/exchange with 503, and the "Googleでログイン" button is
# hidden client-side rather than shown broken.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
