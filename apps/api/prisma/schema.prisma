generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PhotoMedal {
  GOLD
  SILVER
  NONE
}

model Prefecture {
  id     Int    @id
  nameJa String @map("name_ja")
  nameEn String @map("name_en")
  region String
  // 2-4での調査時点では seed.ts が id と同じ値を入れているため、id 順ソート
  // と区別がつかない（冗長）。それでも id とは別カラムとして残しているのは、
  // 将来「特定の県を上位に出す」「地方内の並びを手で調整する」といった
  // 表示順の編集がseedデータの書き換えだけで（スキーマ変更・マイグレーション
  // なしで）できるようにするため。id 自体（都道府県コード相当）を並び替えの
  // 手段に使うと、他の場所（都道府県コードとしての参照）との意味の混同を
  // 招く。
  displayOrder Int    @map("display_order")

  pokeLids PokeLid[]

  @@map("prefectures")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  // Nullable as of 5-4: a Google-only account (no password ever set) has
  // nothing to store here. Exactly one of passwordHash/googleId is allowed
  // to be null, never both — enforced in application code (routes/auth.ts),
  // not the schema, since Prisma/Postgres have no clean way to express "at
  // least one of these two nullable columns is non-null" as a constraint
  // without a CHECK constraint the ORM can't model. login() treats a null
  // passwordHash as "this is a Google-only account" and returns a message
  // pointing the user at Google sign-in instead of the generic
  // wrong-password error.
  passwordHash    String?   @map("password_hash")
  displayName     String    @map("display_name")
  // Google's stable per-account `sub` claim — never the email, which can
  // change on Google's side independently of this row. Unique, nullable:
  // Postgres unique indexes treat NULL as distinct from every other NULL,
  // so any number of password-only accounts can all have googleId = NULL
  // simultaneously (see PokeLid.officialRef for the same nullable-@unique
  // pattern already in this schema).
  googleId        String?   @unique @map("google_id")
  // null for every user created before 5-3, and for anyone who hasn't
  // clicked their verification link yet — never backfilled retroactively
  // (there's no way to know a pre-5-3 signup's address was really theirs).
  // Gates the Google SSO auto-link added in 5-4 (see
  // @pokelids/shared's decideGoogleAccountLink): an unverified existing
  // account must never be auto-linked, since that would let the true owner
  // of an email address that was typo'd or squatted into someone else's
  // registration take over that account just by signing in with Google.
  // Also never gates login or the app itself (ROADMAP.md's "偶然の発見"
  // flow must not be interrupted by an email round trip).
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  refreshTokens           RefreshToken[]
  collections             Collection[]
  photos                  Photo[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @map("token_hash")
  deviceInfo String?   @map("device_info")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Same design as PasswordResetToken above (5-2): random token, only its HMAC
// stored, single-use via usedAt, expiry checked at confirm time. Kept as a
// separate model rather than reusing PasswordResetToken with a `purpose`
// column — a password-reset token and an email-verification token must never
// be interchangeable (a leaked verification-request response must not be
// usable to reset a password), and a shared table makes that a runtime
// invariant to maintain instead of a schema-level impossibility.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PokeLid {
  id                String    @id @default(uuid())
  officialRef       String?   @unique @map("official_ref")
  name              String
  pokemonFeatured   String[]  @map("pokemon_featured")
  prefectureId      Int       @map("prefecture_id")
  municipality      String
  address           String
  latitude          Decimal   @db.Decimal(9, 6)
  longitude         Decimal   @db.Decimal(9, 6)
  officialImageUrl  String?   @map("official_image_url")
  officialSourceUrl String    @map("official_source_url")
  lastSyncedAt      DateTime? @map("last_synced_at")
  // Set by the ETL when a previously-seen officialRef is missing from a scrape
  // (physically removed/closed), cleared again if it later reappears (a
  // renewal-triggered false positive recovering). Never deleted outright:
  // Collection has onDelete: Cascade on pokeLidId, so removing the row would
  // also delete every user's record and photos of having collected it.
  retiredAt         DateTime? @map("retired_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  prefecture  Prefecture   @relation(fields: [prefectureId], references: [id])
  collections Collection[]

  @@index([prefectureId])
  @@index([retiredAt])
  @@map("poke_lids")
}

model Collection {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  pokeLidId String   @map("poke_lid_id")
  visitedAt DateTime @map("visited_at")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pokeLid PokeLid @relation(fields: [pokeLidId], references: [id], onDelete: Cascade)
  photos  Photo[]

  @@unique([userId, pokeLidId])
  @@index([userId])
  @@index([pokeLidId])
  // コレクション画面の GET /api/collections/me（orderBy: visitedAt desc、
  // 7-6でContext化されて呼び出し回数自体は減ったが、クエリは残っている）用。
  @@index([userId, visitedAt])
  @@map("collections")
}

model Photo {
  id                 String     @id @default(uuid())
  collectionId       String     @map("collection_id")
  userId             String     @map("user_id")
  filePath           String     @map("file_path")
  originalFilename   String     @map("original_filename")
  mimeType           String     @map("mime_type")
  fileSizeBytes      Int        @map("file_size_bytes")
  width              Int?
  height             Int?
  exifCapturedAt     DateTime?  @map("exif_captured_at")
  // Distance in meters from the photo's EXIF GPS coordinates to the poke
  // lid's registered location, computed once at upload time. The medal
  // determination (determinePhotoMedal, @pokelids/shared) only ever needs
  // this distance, never the raw coordinates — so unlike the file itself
  // (EXIF-stripped by sharp on re-encode, see resizeForStorage), there's no
  // reason to persist where the photo was actually taken.
  exifDistanceMeters Float?     @map("exif_distance_meters")
  medal              PhotoMedal @default(NONE)
  // 1収集記録につき true は最大1枚という制約は、マイグレーションで生SQLの
  // 部分ユニークインデックス（one_primary_per_collection、WHERE is_primary）
  // として定義している。Prisma は部分ユニークインデックス未対応のため、
  // ここに @@unique 等を書かないこと。書くと通常の（WHERE句なしの）
  // ユニーク制約と解釈され、prisma migrate dev がドリフトとして検出する。
  isPrimary          Boolean    @default(false) @map("is_primary")
  createdAt          DateTime   @default(now()) @map("created_at")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  // 1-2 のアップロード容量チェック（userId で fileSizeBytes を集計）用。
  // TASKS.md 2-4 で予定されていたインデックスだが、このタスクで先に追加する。
  @@index([userId])
  @@map("photos")
}
